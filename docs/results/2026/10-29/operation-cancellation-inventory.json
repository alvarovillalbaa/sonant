      "path": "tests/unit/runtime.test.mjs",
      "sha256": "c66862230cdfb8eb9a4bb9832b1de544600f658df786902c5365f520d380cc6e",
      "literal_cases": 14,
      "case_names": [
        "all characters implement the complete deterministic contract with silent tails",
        "validation rejects incomplete, non-finite and out-of-budget recipes",
        "server imports and unavailable audio are safe and observable",
        "muting stops a live voice and persists bounded preferences",
        "cooldown and voice reservations cover concurrent unlocks",
        "cancellation during unlock never reaches the renderer",
        "a browser unlock that never settles becomes an observable blocked decision",
        "an unresponsive media provider times out, receives cancellation, and releases a late voice",
        "high-priority failure interrupts a lower-priority voice",
        "quiet, speech, category, surface, density and visible-equivalent policies are explicit",
        "watchdog stops loops but a later real result still emits exactly once",
        "destroy during async provider playback releases the eventual voice",
        "provider failures are isolated and traces remain bounded and exportable",
        "malformed stored preferences cannot erase safe defaults"
      ]
    },
    {
      "path": "tests/unit/operation-cancellation.test.mjs",
      "sha256": "893bd17eb69ef771055045c165d1a27535675b28b899440d1ef2cc337b6656b6",
      "literal_cases": 10,
      "case_names": [
        "a pre-aborted caller never unlocks or plays and its operation settles",
        "caller cancellation during pending unlock prevents late progress playback",
        "caller cancellation during pending progress playback releases its eventual voice",
        "caller abort stops active progress and a pending update despite synchronous terminal reentry",
        "explicit operation stop cancels a pending update as well as progress",
        "watchdog completion permits a real result while later caller abort cancels renewed updates and outcomes",
        "resolve and reject settle once under provider reentry without cancelling their confirmed outcome",
        "caller listeners detach when progress ends or settles while an asynchronous outcome remains cancellable",
        "natural progress completion retains caller cancellation for an already pending or active update",
        "caller cancellation synchronously inside provider unlock or play cannot retain a voice"
      ]
    }
